report/skeleton.pdf
report/chapters.zip
# Catch env-style files Neon/Render/etc download when you hit "download .env".
# They look like env.txt / production.env / neon.env and have real secrets.
*.env
env.txt
*.local
uploads/
.DS_Store
# Current dev tunnel URL captured by scripts/dev-tunnel.mjs. Ephemeral.
.tunnel-url
# One-off generated TOTP enrolment QRs. These are secrets-equivalent.
*-totp-qr.png
admin-qr.png
# Usability study: raw participant audio is destroyed after transcription per consent form.
# The audio/ folder is local-only and must never be committed.
report/usability-study/results/audio/
# Real-name to participant-ID mapping. Local-only. Required at anonymisation
# time only; must never be committed. Consent form guarantees names are not
# linked to data in any surviving file.
report/usability-study/results/.name-mapping.private.json
