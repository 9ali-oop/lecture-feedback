{
  "name": "lecture-feedback",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "tunnel": "node scripts/dev-tunnel.mjs",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @lecture-feedback/web build",
    "start": "pnpm --filter @lecture-feedback/api start",
    "db:push": "pnpm --filter @lecture-feedback/api db:push",
    "db:seed": "pnpm --filter @lecture-feedback/api db:seed",
    "db:studio": "pnpm --filter @lecture-feedback/api db:studio"
  },
  "devDependencies": {
    "marked": "^12.0.0",
    "playwright": "^1.59.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "ws": "^8.20.0"
  }
}
